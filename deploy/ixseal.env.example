# /etc/ixseal/ixseal.env (root:ixseal 0640)
# PostgreSQL: 같은 VM, 유닉스 소켓 + peer 인증 (OS 사용자 ixseal = DB 역할 ixseal)
IXSEAL_DATABASE_URL=postgresql:///ixseal
IXSEAL_KEK_FILE=/etc/ixseal/kek
# 고객 링크 앞부분. 개발: https://<VM 공인 IP>  / 운영: https://seal.ixcloud.net
IXSEAL_PUBLIC_BASE_URL=https://__SERVER_NAME__
IXSEAL_HELPDESK_EMAIL=help_cloud@kinx.net
# 관리 화면 상단 환경 표시 (운영에서는 비운다)
IXSEAL_ENV_LABEL=DEV
IXSEAL_COOKIE_SECURE=true
IXSEAL_TIMEZONE=Asia/Seoul
# 정적 파일은 Nginx가 제공
IXSEAL_SERVE_STATIC=false
# 파일 제한 (Nginx client_max_body_size 60m 과 맞춘다)
IXSEAL_MAX_FILE_MB=20
IXSEAL_MAX_FILES=10
IXSEAL_MAX_TOTAL_MB=50
IXSEAL_REVEAL_SESSION_MINUTES=10
IXSEAL_RETENTION_DAYS=730
