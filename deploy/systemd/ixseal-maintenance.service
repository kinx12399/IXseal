[Unit]
Description=IXseal 정리 작업 (만료 폐기, 1회 열람 후 파일 폐기, 오래된 기록 삭제)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=ixseal
Group=ixseal
WorkingDirectory=/opt/ixseal/app
EnvironmentFile=/etc/ixseal/ixseal.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ixseal/venv/bin/python -m ixseal maintenance

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
