[Unit]
Description=IXseal DB 백업 (암호문 그대로, 7일 보관)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=ixseal
Group=ixseal
ExecStart=/opt/ixseal/app/deploy/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ixseal
UMask=0077
